+  await step('настоящий «сторож»: зависший (молчащий) сервер обнаруживается и соединение пересоздаётся', async () => {
+    const server = startFakeAxelChat({ alive: false });
+    const { svc, warns } = makeConnector();
+    svc.start({ port: PORT });
